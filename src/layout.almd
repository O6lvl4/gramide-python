// Python physical tokens -> logical NEWLINE / INDENT / DEDENT tokens.
// The scanner must preserve physical newline, comment and continuation tokens,
// and keep strings (including their embedded newlines) as single tokens.
// Strict layout remains the default; EOF delimiter recovery is explicit.
import gramide.tree
import gramide.lex

type Indent = { width: Int, alternate: Int }

fn indentation(source: Bytes, at: Int) -> Indent = {
  var i = at
  var width = 0
  var alternate = 0
  var scanning = true
  while scanning {
    match bytes.get_or(source, i, -1) {
      32 => { width = width + 1; alternate = alternate + 1; i = i + 1 },
      9 => { width = (width / 8 + 1) * 8; alternate = alternate + 1; i = i + 1 },
      12 => { width = 0; alternate = 0; i = i + 1 },
      _ => { scanning = false },
    }
  }
  Indent { width: width, alternate: alternate }
}

// A delimiter is one byte. Reading it from the source decides bracket nesting
// without copying the token's text or building a list of spellings for every
// punctuation token in the file.
fn single_byte(buffer: Bytes, t: tree.Token) -> Int =
  if t.end - t.start == 1 then bytes.get_or(buffer, t.start, -1) else -1
fn opens_bracket(b: Int) -> Bool = b == 40 or b == 91 or b == 123
fn opener_of(b: Int) -> Int = if b == 41 then 40 else if b == 93 then 91 else if b == 125 then 123 else -1

// The words that begin a statement and nothing else, at the start of a line
let STATEMENT_HEADS = ["def", "class", "if", "elif", "else", "for", "while", "try", "except", "finally", "with", "return", "import", "from", "pass", "raise", "assert", "del", "global", "nonlocal", "async", "@"]
// Whether the next code token after position `at` in the physical stream
// begins a line with a statement word, at an indentation no deeper than the
// line that opened `opening`
fn statement_resumes(buffer: Bytes, physical: List[tree.Token], at: Int, opening: tree.Token) -> Bool = {
  var i = at
  var next: Option[tree.Token] = none
  while option.is_none(next) and i < list.len(physical) {
    match list.get(physical, i) { some(n) => if n.kind != tree.T_COMMENT and n.kind != tree.T_NEWLINE and n.kind != tree.T_CONTINUATION then next = some(n) else (), none => () }
    i = i + 1
  }
  match next {
    none => false,
    some(n) => {
      let line_start = n.start - n.col + 1
      let here = indentation(buffer, line_start)
      let opener_line = indentation(buffer, opening.start - opening.col + 1)
      n.kind != tree.T_EOF and here.width == n.col - 1 and here.width <= opener_line.width
        and list.contains(STATEMENT_HEADS, bytes.to_string_lossy(bytes.slice(buffer, n.start, n.end)))
    },
  }
}
// Recovering, at a line end inside a bracket an edit left open: the tokens
// since the opener become one error token and the bracket is closed
fn close_open_bracket(mut out: List[tree.Token], mut brackets: List[tree.Token], bracket_start: Int, t: tree.Token) -> Unit = {
  let opening = list.get(brackets, 0) ?? t
  while list.len(out) > bracket_start { let _ = list.pop(out) }
  list.push(out, tree.Token { ...opening, kind: tree.T_ERROR, end: t.start })
  list.clear(brackets)
}
// A closer: it pops the innermost opener when they match. Otherwise, strict,
// the file fails; recovering, the answer says whether the closer is a stray
// (an error token), which it is with nothing open, or when nothing open is
// of its kind
fn close_bracket(mut brackets: List[tree.Token], buffer: Bytes, t: tree.Token, expected: Int, recovering: Bool) -> Result[Bool, lex.LexError] = {
  if recovering and list.is_empty(brackets) then ok(true)
  else {
    let opener = list.pop(brackets)
    let opened = match opener { some(opening) => single_byte(buffer, opening), none => -1 }
    if opened == expected then ok(false)
    else {
      guard recovering else err(fail(t, "mismatched closing delimiter"))
      ok(not close_mismatched(brackets, buffer, expected, opener))
    }
  }
}
// Recovering, a closer that does not match the innermost opener (already
// popped): one of a kind open deeper closes down to it — the openers between
// were left open by the edit — and the answer is true; one that matches
// nothing open is a stray, the innermost opener stays, and the answer is false
fn close_mismatched(mut brackets: List[tree.Token], buffer: Bytes, expected: Int, opener: Option[tree.Token]) -> Bool = {
  let depth = last_opener(buffer, brackets, expected)
  if depth >= 0 then { while list.len(brackets) > depth { let _ = list.pop(brackets) }; true }
  else { match opener { some(o) => list.push(brackets, o), none => () }; false }
}
// The index in `brackets` of the innermost opener of kind `expected`, -1 when none is open
fn last_opener(buffer: Bytes, brackets: List[tree.Token], expected: Int) -> Int = {
  var i = list.len(brackets) - 1
  var found = -1
  while found < 0 and i >= 0 {
    match list.get(brackets, i) { some(b) => if single_byte(buffer, b) == expected then found = i else (), none => () }
    i = i - 1
  }
  found
}
fn marker(kind: Int, at: tree.Token) -> tree.Token =
  tree.Token { kind: kind, start: at.start, end: at.start, line: at.line, col: at.col }

fn fail(at: tree.Token, message: String) -> lex.LexError =
  lex.LexError { line: at.line, col: at.col, message: message }

fn change_indent(mut levels: List[Indent], mut out: List[tree.Token], next: Indent, at: tree.Token) -> Result[Unit, lex.LexError] = {
  let previous = list.last(levels) ?? Indent { width: 0, alternate: 0 }
  if next.width > previous.width then {
    guard list.len(levels) < 100 else err(fail(at, "too many levels of indentation"))
    guard next.alternate > previous.alternate else err(fail(at, "inconsistent tabs and spaces in indentation"))
    list.push(levels, next)
    list.push(out, marker(tree.T_INDENT, at))
  } else {
    while list.len(levels) > 1 and (option.map(list.last(levels), (v) => v.width) ?? 0) > next.width {
      let _ = list.pop(levels)
      list.push(out, marker(tree.T_DEDENT, at))
    }
    let top = list.last(levels) ?? Indent { width: 0, alternate: 0 }
    guard top.width == next.width else err(fail(at, "unindent does not match any outer indentation level"))
    guard top.alternate == next.alternate else err(fail(at, "inconsistent tabs and spaces in indentation"))
  }
  ok(())
}

fn apply_with(source: String, physical: List[tree.Token], recovering: Bool) -> Result[List[tree.Token], lex.LexError] = {
  guard (option.map(list.last(physical), (t) => t.kind) ?? tree.T_NONE) == tree.T_EOF else err(lex.LexError { line: 1, col: 1, message: "physical token stream requires EOF" })
  let buffer = bytes.from_string(source)
  var out: List[tree.Token] = []
  var levels = [Indent { width: 0, alternate: 0 }]
  var brackets: List[tree.Token] = []
  var bracket_start = 0
  var beginning = true
  var code = false
  var continuation: Option[tree.Token] = none
  var prefix: Option[Indent] = none
  var idx = 0
  while idx < list.len(physical) {
    let t = list.get(physical, idx) ?? tree.Token { kind: tree.T_EOF, start: 0, end: 0, line: 1, col: 1 }
    idx = idx + 1
    if t.kind == tree.T_COMMENT then { continuation = none }
    else if t.kind == tree.T_CONTINUATION then {
      if beginning then {
        let here = indentation(buffer, t.start - t.col + 1)
        // CPython retains the first nonzero column across leading backslashes.
        if (option.map(prefix, (p) => p.width) ?? 0) == 0 and here.width > 0 then prefix = some(Indent { width: here.width, alternate: here.width }) else ()
      } else ()
      continuation = some(t)
    }
    else if t.kind == tree.T_NEWLINE then {
      continuation = none
      // recovering, inside a bracket an edit left open: a line that begins a
      // statement at the opener's line's indentation or less is not a
      // continuation of it. Close the bracket here — the tokens since the
      // opener become one error token — and let the line end count
      if recovering and not list.is_empty(brackets) and statement_resumes(buffer, physical, idx, list.get(brackets, 0) ?? t) then close_open_bracket(out, brackets, bracket_start, t) else ()
      if list.is_empty(brackets) and code then {
        list.push(out, t)
        beginning = true
        code = false
        prefix = none
      } else if list.is_empty(brackets) then { prefix = none } else ()
    }
    else if t.kind == tree.T_EOF then {
      guard option.is_none(continuation) or (recovering and not list.is_empty(brackets)) else err(fail(continuation ?? t, "unexpected EOF after line continuation"))
      if not list.is_empty(brackets) then {
        guard recovering else err(fail(list.last(brackets) ?? t, "unclosed delimiter"))
        // Every physical newline since this opening was inside brackets. Keep
        // that entire tail opaque; never promote its apparent declarations.
        let opening = list.get(brackets, 0) ?? t
        while list.len(out) > bracket_start { let _ = list.pop(out) }
        list.push(out, tree.Token { ...opening, kind: tree.T_ERROR, end: t.start })
      } else ()
      if code then list.push(out, marker(tree.T_NEWLINE, t)) else ()
      while list.len(levels) > 1 {
        let _ = list.pop(levels)
        list.push(out, marker(tree.T_DEDENT, t))
      }
      list.push(out, t)
    }
    else {
      var stray_closer = false
      if beginning then {
        let next = prefix ?? indentation(buffer, t.start - t.col + 1)
        change_indent(levels, out, next, t)!
        prefix = none
        beginning = false
      } else ()
      if t.kind == tree.T_PUNCT then {
        let delimiter = single_byte(buffer, t)
        let expected = opener_of(delimiter)
        if opens_bracket(delimiter) then {
          guard list.len(brackets) < 200 else err(fail(t, "too many nested delimiters"))
          if list.is_empty(brackets) then bracket_start = list.len(out) else ()
          list.push(brackets, t)
        }
        else if expected >= 0 then stray_closer = close_bracket(brackets, buffer, t, expected, recovering)!
        else ()
      } else ()
      list.push(out, if stray_closer then tree.Token { ...t, kind: tree.T_ERROR } else t)
      code = true
      continuation = none
    }
  }
  ok(out)
}

fn apply(source: String, physical: List[tree.Token]) -> Result[List[tree.Token], lex.LexError] = apply_with(source, physical, false)

test "indentation follows Python tab stops and formfeed resets" {
  assert_eq(indentation(bytes.from_string(" \tx"), 0), Indent { width: 8, alternate: 2 })
  assert_eq(indentation(bytes.from_string("        x"), 0), Indent { width: 8, alternate: 8 })
  assert_eq(indentation(bytes.from_string("  \u{000c} x"), 0), Indent { width: 1, alternate: 1 })
}

test "a delimiter is decided by one byte of the source" {
  let src = bytes.from_string("([{)]}+")
  let open_paren = tree.Token { kind: tree.T_PUNCT, start: 0, end: 1, line: 1, col: 1 }
  let close_bracket = tree.Token { kind: tree.T_PUNCT, start: 4, end: 5, line: 1, col: 5 }
  let plus = tree.Token { kind: tree.T_PUNCT, start: 6, end: 7, line: 1, col: 7 }
  let two_bytes = tree.Token { kind: tree.T_PUNCT, start: 0, end: 2, line: 1, col: 1 }
  assert_eq(opens_bracket(single_byte(src, open_paren)), true)
  assert_eq(opens_bracket(single_byte(src, close_bracket)), false)
  assert_eq(opener_of(single_byte(src, close_bracket)), 91)
  assert_eq(opener_of(single_byte(src, plus)), -1)
  assert_eq(single_byte(src, two_bytes), -1)
}

