// symbols — which of this grammar's nodes declare a name, which own methods,
// and which reference one: the rules the readers in gramide walk with.
// What those readers then say about Python is checked against CPython in
// ci/python_symbols.py and ci/python_tags.py.
import gramide.package_api

fn symbol_rules() -> package_api.SymbolRules = package_api.SymbolRules {
  declarations: [("function_declaration", "function"), ("class_declaration", "class"), ("type_alias", "type")],
  scopes: ["class_declaration"], namespaces: ["class_declaration", "function_declaration"],
  callables: ["function_declaration"], lexical_owners: true, envelopes: [], unnamed_envelopes: [],
  // Python spells a call `call` and a field read `attribute`, and it has no node
  // for a type: a type is whatever is written after a `:`, after a `->`, or in a
  // class's bases. Those three say where to look, and the shared rule — the
  // first thing in it, if that is a bare name — says what counts.
  arguments: "call", field_access: "attribute", type_mentions: ["annotation", "returns", "bases"]
}
